{
  "manifest_version": 2,
  "name": "Deepify Focus Companion",
  "version": "0.1.0",
  "description": "Paired-profile website restriction for Deepify focus sessions.",
  "browser_specific_settings": { "gecko": { "id": "focus@deepify.local", "strict_min_version": "120.0" } },
  "incognito": "not_allowed",
  "permissions": ["<all_urls>", "storage", "tabs", "webRequest", "webRequestBlocking", "nativeMessaging"],
  "web_accessible_resources": ["blocked.html", "blocked.css", "blocked.js"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Deepify" }
}
